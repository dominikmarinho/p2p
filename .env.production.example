POSTGRES_DB=highpass_db
POSTGRES_USER=highpass_user
# Gere valores aleatórios com openssl rand -hex 32; não use estes exemplos em produção.
POSTGRES_PASSWORD=replace_with_random_hex_postgres_password
DATABASE_URL=postgresql://highpass_user:replace_with_random_hex_postgres_password@postgres:5432/highpass_db
REDIS_PASSWORD=replace_with_random_hex_redis_password
JWT_SECRET=replace_with_random_hex_jwt_secret_minimum_32_chars
APP_IMAGE=ghcr.io/dominikmarinho/p2p:latest
APP_PORT=3001
DB_POOL_MAX=10
ADMIN_BOOTSTRAP_KEY=replace_with_random_admin_key_minimum_32_chars
CONFIG_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
XUI_ALLOWED_HOSTS=xuione.remoto.api.br
XUI_ALLOW_HTTP=true
METRICS_TOKEN=replace_with_random_metrics_token_minimum_32_chars
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=replace_with_random_grafana_password
XUI_BASE_URL=http://xuione.remoto.api.br
PUBLIC_ENGINE_URL=https://p2p.remoto.api.br
RTC_ICE_SERVERS=[{"urls":"stun:stun.l.google.com:19302"}]

ADMIN_INITIAL_PASSWORD=replace_with_random_initial_admin_password
