{
  "name": "highpass-p2p-engine",
  "version": "1.3.4",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "dev": "tsx watch --env-file=.env src/server.ts",
    "build": "npm run build:web && npm run build:server",
    "start": "node dist/server.js",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "dev:web": "npm run dev --workspace highpass-webplayer",
    "build:web": "node scripts/build-web.mjs",
    "typecheck:web": "npm run typecheck --workspace highpass-webplayer",
    "build:server": "tsc -p tsconfig.build.json",
    "test:browser": "BUILD_LEGACY_TEST_CLIENT=1 npm run build:web && tsx tests/e2e/iptv-browser.ts && tsx tests/e2e/vod-relay.ts && tsx tests/e2e/native-vod-seek.ts && tsx tests/e2e/seed-delivery.ts && tsx tests/e2e/admin-navigation.ts && tsx tests/e2e/seed-lifecycle.ts && tsx tests/e2e/isolated-transports.ts && tsx tests/e2e/seed-redundancy.ts && tsx tests/e2e/playback-diagnostics.ts",
    "build:roku": "bsc --project apps/roku/bsconfig.json",
    "build:tv": "npm run build:roku && python3 scripts/package-tizen.py && npm exec --yes --package=@webos-tools/cli@3.2.6 -- ares-package apps/webos -o artifacts",
    "test:container": "tsx tests/e2e/container-seed.ts"
  },
  "dependencies": {
    "@fastify/helmet": "^13.0.0",
    "@fastify/jwt": "^10.0.0",
    "@fastify/rate-limit": "^10.0.0",
    "@fastify/websocket": "^11.0.0",
    "@noble/ciphers": "^2.4.0",
    "@prometheus-io/client": "^0.16.1",
    "dotenv": "^16.6.0",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.6.0",
    "fastify-metrics": "^15.0.0",
    "fastify-type-provider-zod": "^7.0.0",
    "ioredis": "^5.7.0",
    "pg": "^8.16.0",
    "pino": "^9.9.0",
    "playwright-core": "^1.64.1",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.15.0",
    "@types/ws": "^8.18.0",
    "brighterscript": "^0.73.8",
    "drizzle-kit": "^0.31.0",
    "eslint": "^9.0.0",
    "globals": "^16.0.0",
    "playwright": "^1.64.1",
    "pm2": "^6.0.0",
    "tsx": "^4.20.0",
    "typescript": "~5.9.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^3.2.0",
    "ws": "^8.18.0"
  },
  "workspaces": [
    "apps/webplayer"
  ]
}
