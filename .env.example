NODE_ENV=development
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=info
POSTGRES_DB=highpass_db
POSTGRES_USER=highpass_user
POSTGRES_PASSWORD=local_postgres_only
DATABASE_URL=postgresql://highpass_user:local_postgres_only@127.0.0.1:5432/highpass_db
DB_POOL_MAX=10
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=local_redis_only
JWT_SECRET=local-only-change-this-secret-at-least-32-characters
JWT_ISSUER=highpass
JWT_AUDIENCE=highpass-api
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000
RATE_LIMIT_MAX=100
TRUST_PROXY_HOPS=0
SHUTDOWN_TIMEOUT_MS=20000
ADMIN_BOOTSTRAP_KEY=local-admin-key-change-before-production
CONFIG_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
XUI_ALLOWED_HOSTS=localhost,127.0.0.1
XUI_ALLOW_HTTP=true
METRICS_TOKEN=local-metrics-token-change-before-production
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=local-grafana-change-before-production
XUI_BASE_URL=http://xuione.remoto.api.br
PUBLIC_ENGINE_URL=https://p2p.remoto.api.br
RTC_ICE_SERVERS=[{"urls":"stun:stun.l.google.com:19302"}]

P2P_SEED_ENABLED=true
P2P_DELIVERY_ENABLED=true
P2P_SEED_MAX_STREAMS=4
P2P_SEED_WORKERS=2
P2P_SEGMENT_TIMEOUT_MS=3000
# TURN REST: segredo somente no servidor; clientes recebem credenciais temporárias.
TURN_URLS=
TURN_SHARED_SECRET=

# Compatibilidade da origem HTTP autorizada com redirects HTTPS legados.
XUI_PRESERVE_HTTP=true
